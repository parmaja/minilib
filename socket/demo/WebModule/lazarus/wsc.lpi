<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <Flags>
        <CompatibilityMode Value="True"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="False"/>
      <Icon Value="0"/>
    </General>
    <VersionInfo>
      <UseVersionInfo Value="True"/>
      <MinorVersionNr Value="1"/>
    </VersionInfo>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
      <Modes Count="1">
        <Mode0 Name="default"/>
      </Modes>
    </RunParams>
    <RequiredPackages Count="4">
      <Item1>
        <PackageName Value="MiniLib"/>
      </Item1>
      <Item2>
        <PackageName Value="MiniConnections"/>
      </Item2>
      <Item3>
        <PackageName Value="MiniSockets"/>
      </Item3>
      <Item4>
        <PackageName Value="MiniWebLib"/>
      </Item4>
    </RequiredPackages>
    <Units Count="2">
      <Unit0>
        <Filename Value="wsc.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit0>
      <Unit1>
        <Filename Value="..\HomeModules.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit1>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="..\wsc"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="..\..\..\source;..;..\..\..\..\web\source"/>
      <UnitOutputDirectory Value=".\wsc_units"/>
    </SearchPaths>
    <Parsing>
      <SyntaxOptions>
        <IncludeAssertionCode Value="True"/>
        <UseAnsiStrings Value="False"/>
        <CStyleMacros Value="True"/>
      </SyntaxOptions>
    </Parsing>
    <CodeGeneration>
      <Checks>
        <IOChecks Value="True"/>
        <RangeChecks Value="True"/>
        <OverflowChecks Value="True"/>
        <StackChecks Value="True"/>
      </Checks>
      <VerifyObjMethodCallValidity Value="True"/>
      <TargetOS Value="win64"/>
    </CodeGeneration>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
        <UseExternalDbgSyms Value="True"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="False"/>
        </Win32>
      </Options>
    </Linking>
    <Other>
      <CustomOptions Value="-dDEBUG"/>
      <OtherDefines Count="1">
        <Define0 Value="DEBUG"/>
      </OtherDefines>
    </Other>
  </CompilerOptions>
</CONFIG>
